# Anthropic API Key for Portfolio Data Generation
# Get your free key from: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_api_key_here

# Instructions:
# 1. Replace 'your_api_key_here' with your actual Claude API key
# 2. Save the file
# 3. Run: npm run generate:portfolio
